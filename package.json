{
  "name": "pixel-agents",
  "description": "Pixel art office where your Claude Code agents come to life as animated characters",
  "version": "1.0.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/pablodelucca/pixel-agents"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "pixel-agents": "./bin/pixel-agents.js"
  },
  "scripts": {
    "dev": "npm-run-all -p dev:server dev:webview",
    "dev:mock": "npm-run-all -p dev:server:mock dev:webview",
    "dev:server": "cd server && npx tsx watch src/index.ts",
    "dev:server:mock": "cd server && npx tsx watch src/index.ts -- --mock 3",
    "dev:webview": "cd webview-ui && npm run dev -- --open",
    "build": "npm run build:webview && npm run build:server",
    "build:webview": "cd webview-ui && npm run build",
    "build:server": "cd server && npx esbuild src/index.ts --bundle --platform=node --format=esm --outfile=../dist/server.js --external:node-pty --external:express --external:ws --external:pngjs && ln -sf ../server/node_modules ../dist/node_modules",
    "start": "node dist/server.js",
    "test:cli": "node --test bin/cli.test.js",
    "prepare": "husky",
    "lint": "cd server && npx eslint src",
    "lint:webview": "cd webview-ui && npm run lint",
    "format": "prettier --write \"server/src/**/*.ts\" \"webview-ui/src/**/*.{ts,tsx,css}\" \"*.{js,mjs}\" \"webview-ui/*.{js,ts}\"",
    "format:check": "prettier --check \"server/src/**/*.ts\" \"webview-ui/src/**/*.{ts,tsx,css}\" \"*.{js,mjs}\" \"webview-ui/*.{js,ts}\""
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@types/node": "22.x",
    "@types/pngjs": "^6.0.5",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "lint-staged": {
    "server/src/**/*.ts": "eslint --fix",
    "webview-ui/src/**/*.{ts,tsx}": "eslint --fix",
    "*.{ts,tsx,js,mjs,css,json,md}": "prettier --write",
    "webview-ui/**/*.{ts,tsx,js,css,json}": "prettier --write"
  }
}
